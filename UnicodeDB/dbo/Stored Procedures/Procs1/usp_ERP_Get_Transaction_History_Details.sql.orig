;WITH cte AS
(
    SELECT 
        SD.S_Student_ID,
        SD.S_First_Name,
        SD.S_Middle_Name,
        SD.S_Last_Name,
        LTRIM(RTRIM(
            SD.S_First_Name
            + CASE WHEN SD.S_Middle_Name IS NULL OR SD.S_Middle_Name = '' 
                   THEN '' ELSE ' ' + SD.S_Middle_Name END
            + CASE WHEN SD.S_Last_Name IS NULL OR SD.S_Last_Name = '' 
                   THEN '' ELSE ' ' + SD.S_Last_Name END
        )) AS FullName,
        SD.I_Enquiry_Regn_ID,
        RH.I_Receipt_Header_ID     AS ReceiptHeaderID,
        RH.S_Receipt_No            AS ReceiptNo,
        RT.S_Status_Desc           AS ReceiptType,
        TM.I_ERP_TransactionNo     AS TransactionNo,
        CASE WHEN TID.I_ERP_Transaction_Master_ID IS NULL THEN 'Offline' ELSE 'Online' END AS PaymentMethod,
        CASE WHEN TID.I_ERP_Transaction_Master_ID IS NULL THEN PMM.S_PaymentMode_Name ELSE TM.S_TransactionMode END AS PaymentMode,
        PMM.I_PaymentMode_ID       AS SMSPaymentModeID,
        PMM.S_PaymentMode_Name     AS SMSPaymentMode,
        CASE WHEN IOD.I_OnAccount_Ivoice_ID IS NOT NULL OR RH.I_Invoice_Header_ID IS NOT NULL THEN 'false' ELSE 'true' END AS isAdhoc,
        IOD.S_Invoice_Number       AS AdhocInvoiceNo,
        TM.Dt_TransactionDate      AS TransactionDate,
        RH.Dt_Receipt_Date         AS ReceiptDate,
        TM.I_TransactionTotalAmount AS TotalTransactionAmount,
        RH.N_Receipt_Amount        AS AmountBreakupReceiptWise,
        RH.N_Tax_Amount            AS TaxBreakupReceiptWise,
        CASE 
            WHEN TM.S_TransactionStatus = 'Initiated' 
                 AND DATEDIFF(MINUTE, TM.Dt_TransactionDate, GETDATE()) > 60 THEN 2
            WHEN TM.S_TransactionStatus = 'Initiated' THEN 1
            WHEN TM.S_TransactionStatus = 'Success'   THEN 3
            WHEN TM.S_TransactionStatus = 'Failure'   THEN 4 
            WHEN TM.S_TransactionStatus IS NULL 
                 AND RH.I_Receipt_Header_ID IS NOT NULL THEN 3
            ELSE NULL
        END                        AS PaymentStatusID,
        RH.I_Status                AS ReceiptStatus,
        RH.Dt_Deposit_Date         AS SattlementDate,
        RH.Bank_Account_Name       AS SattlementBankAccount,
        TM.I_ERP_Brand_PaymentGateway_Map_id AS PaymnentGatewayID,
        BCD.I_Brand_ID             AS BrandID,
        TM.S_Mobile_No             AS ExternalPurchasedMobileNo,
        TM.Order_ID                AS OrderID,
        TM.PG_History_ID           AS PGHistoryID,
        TM.RequestLogID            AS RequestLogID,
        TM.PaymentJson             AS PaymentJson,
        ROW_NUMBER() OVER (
            PARTITION BY RH.I_Receipt_Header_ID, TM.I_ERP_TransactionNo
            ORDER BY TM.Dt_TransactionDate DESC
        ) rn
    FROM 
        T_Receipt_Header AS RH
    INNER JOIN dbo.T_PaymentMode_Master PMM WITH (NOLOCK) 
        ON RH.I_PaymentMode_ID = PMM.I_PaymentMode_ID
    INNER JOIN dbo.T_Status_Master RT WITH (NOLOCK) 
        ON RT.S_Status_Type = 'ReceiptType' AND RH.I_Receipt_Type = RT.I_Status_Value
    INNER JOIN dbo.T_Centre_Master CEM WITH (NOLOCK) 
        ON RH.I_Centre_Id = CEM.I_Centre_Id
    INNER JOIN dbo.T_Brand_Center_Details AS BCD WITH (NOLOCK) 
        ON CEM.I_Centre_Id = BCD.I_Centre_Id
    INNER JOIN dbo.T_Brand_Master AS BM WITH (NOLOCK) 
        ON BCD.I_Brand_ID = BM.I_Brand_ID
    INNER JOIN dbo.T_Student_Detail AS SD WITH (NOLOCK) 
        ON RH.I_Student_Detail_ID = SD.I_Student_Detail_ID 
        OR RH.I_Enquiry_Regn_ID = SD.I_Enquiry_Regn_ID
    LEFT JOIN dbo.T_Invoice_OnAccount_Details AS IOD WITH (NOLOCK) 
        ON IOD.I_Receipt_Header_ID = RH.I_Receipt_Header_ID
    LEFT JOIN T_ERP_Transaction_Invoice_Details AS TID 
        ON TID.ReceiptHeaderID = RH.I_Receipt_Header_ID
    LEFT JOIN T_ERP_Transaction_Master AS TM 
        ON TM.I_ERP_Transaction_Master_ID = TID.I_ERP_Transaction_Master_ID
    WHERE RH.I_Receipt_Header_ID = @receiptHeaderID
)
INSERT INTO #Transaction_History
(
    StudentID,
    S_First_Name,
    S_Middle_Name,
    S_Last_Name,
    FullName,
    EnquiryNo,
    ReceiptHeaderID,
    ReceiptNo,
    ReceiptType,
    TransactionNo,
    PaymentMethod,
    PaymentMode,
    SMSPaymentModeID,
    SMSPaymentMode,
    isAdhoc,
    AdhocInvoiceNo,
    TransactionDate,
    ReceiptDate,
    TotalTransactionAmount,
    AmountBreakupReceiptWise,
    TaxBreakupReceiptWise,
    PaymentStatusID,
    ReceiptStatus,
    SattlementDate,
    SattlementBankAccount,
    PaymnentGatewayID,
    BrandID,
    ExternalPurchasedMobileNo,
    OrderID,
    PGHistoryID,
    RequestLogID,
    PaymentJson
)
SELECT 
    S_Student_ID,
    S_First_Name,
    S_Middle_Name,
    S_Last_Name,
    FullName,
    I_Enquiry_Regn_ID,
    ReceiptHeaderID,
    ReceiptNo,
    ReceiptType,
    TransactionNo,
    PaymentMethod,
    PaymentMode,
    SMSPaymentModeID,
    SMSPaymentMode,
    isAdhoc,
    AdhocInvoiceNo,
    TransactionDate,
    ReceiptDate,
    TotalTransactionAmount,
    AmountBreakupReceiptWise,
    TaxBreakupReceiptWise,
    PaymentStatusID,
    ReceiptStatus,
    SattlementDate,
    SattlementBankAccount,
    PaymnentGatewayID,
    BrandID,
    ExternalPurchasedMobileNo,
    OrderID,
    PGHistoryID,
    RequestLogID,
    PaymentJson
FROM cte
WHERE rn = 1;




   END
