CREATE PROCEDURE [dbo].[USP_UpdateNotificationLogStatus]  
    @inNotificationLogsID INT,  
    @stNotificationStatus VARCHAR(255),  
    @stErrorMessage NVARCHAR(MAX) = NULL,  
    @stRenderMessageBody NVARCHAR(MAX) = NULL,  
    @inSendStatus INT = NULL  
AS  
BEGIN  
    SET NOCOUNT ON;  
      
    BEGIN TRY  
        UPDATE T_ERP_Notification_Schedule_Logs  
        SET   
            stNotificationStatus = @stNotificationStatus,  
            stErrorMessage = @stErrorMessage,  
            stRenderMessageBody = @stRenderMessageBody,  
            inSendStatus = @inSendStatus  
        WHERE   
            inNotificationLogsID = @inNotificationLogsID;  
              
        SELECT 1 AS StatusFlag, 'Notification log status updated successfully' AS Message;  
    END TRY  
    BEGIN CATCH  
        SELECT 0 AS StatusFlag, ERROR_MESSAGE() AS Message;  
    END CATCH  
END;  